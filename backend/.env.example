# Private Hotline relay — configuration
# Copy to .env (or set in your host dashboard, e.g. Render.com environment vars)

# Port to bind (Render sets this automatically)
PORT=8080

# Shared secret the OWNER app uses for management calls (register identity,
# create invites, list/revoke pairs). Generate with: openssl rand -base64 32
OWNER_TOKEN=

# Store: leave FIRESTORE_PROJECT_ID empty to use the in-memory store (dev).
# Set it + GOOGLE_APPLICATION_CREDENTIALS to activate the Firestore store.
FIRESTORE_PROJECT_ID=

# Invite behaviour
INVITE_TTL_HOURS=72
INVITE_CODE_BYTES=24

# Offline queue cap per pair per role
OFFLINE_QUEUE_MAX=500

# CORS for socket connections (comma separated, or * for dev)
CORS_ORIGINS=*

# Optional TURN relay for symmetric-NAT fallback (Coturn / open relay)
# TURN_URL=turn:turn.example.com:3478
# TURN_USER=
# TURN_CREDENTIAL=
